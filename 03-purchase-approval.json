      "name": "26 - Find Pending Purchase Request."
    },
    {
      "parameters": {
        "jsCode": "\nconst form = $('25 - Purchase Approval Form').first().json;\nconst request = $input.first().json;\n\n// Read the manager's submitted decision\nconst decision = String(form['Decision'] ?? '')\n  .trim()\n  .toUpperCase();\n\nconst managerName = String(form['Manager Name'] ?? '')\n  .trim();\n\nconst recommendationKey = String(\n  form['Recommendation Key'] ?? ''\n).trim();\n\nconst approvedQuantityRaw = form['Approved Quantity'];\n\nconst approvedQuantity =\n  approvedQuantityRaw === undefined ||\n  approvedQuantityRaw === null ||\n  String(approvedQuantityRaw).trim() === ''\n    ? null\n    : Number(approvedQuantityRaw);\n\n// Read the existing recommendation\nconst currentStatus = String(\n  request['Approval Status'] ?? ''\n).trim().toUpperCase();\n\nconst savedKey = String(\n  request['Pending Key'] ?? ''\n).trim();\n\n// Validate the request\nlet valid = true;\nlet message = '';\n\nif (!recommendationKey || recommendationKey !== savedKey) {\n  valid = false;\n  message = 'Recommendation key does not match.';\n\n} else if (currentStatus !== 'PENDING') {\n  valid = false;\n  message = 'This recommendation is no longer pending.';\n\n} else if (!managerName) {\n  valid = false;\n  message = 'Manager name is required.';\n\n} else if (!['APPROVED', 'REJECTED'].includes(decision)) {\n  valid = false;\n  message = 'Invalid approval decision.';\n\n} else if (\n  decision === 'APPROVED' &&\n  (!Number.isInteger(approvedQuantity) ||\n   approvedQuantity <= 0)\n) {\n  valid = false;\n  message = 'Approved quantity must be a positive whole number.';\n\n} else {\n  message = 'Purchase decision validated successfully.';\n}\n\n// Return the result\nreturn [{\n  json: {\n    ...request,\n    row_number: request.row_number,\n    recommendationKey,\n    managerName,\n    decision,\n    approvedQuantity: decision === 'APPROVED'\n      ? approvedQuantity\n      : null,\n    remarks: form['Remarks'] ?? '',\n    valid,\n    message,\n    approvalDate: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
