    {
      "parameters": {
        "jsCode": "\nconst products = $input.all();\n\n// Find fields even if headers contain extra spaces\nfunction getField(data, fieldName) {\n  const normalize = value =>\n    String(value).toLowerCase().replace(/\\s+/g, '');\n\n  const key = Object.keys(data).find(\n    k => normalize(k) === normalize(fieldName)\n  );\n\n  return key === undefined ? undefined : data[key];\n}\n\n// Safely convert spreadsheet values into numbers\nfunction toNumber(value, fieldName, productId) {\n  if (\n    value === undefined ||\n    value === null ||\n    String(value).trim() === ''\n  ) {\n    throw new Error(\n      fieldName + ' is missing for ' + productId\n    );\n  }\n\n  const number = Number(\n    String(value).replace(/,/g, '').trim()\n  );\n\n  if (!Number.isFinite(number) || number < 0) {\n    throw new Error(\n      fieldName + ' is invalid for ' + productId\n    );\n  }\n\n  return number;\n}\n\n// Analyse every inventory record\nreturn products.map(item => {\n\n  const product = item.json;\n\n  const productId = getField(product, 'Product ID');\n\n  const productName = getField(product, 'Product Name');\n\n  const branch = getField(product, 'Branch');\n\n  const currentStock = toNumber(\n    getField(product, 'Current Stock'),\n    'Current Stock',\n    productId\n  );\n\n  const minimumStock = toNumber(\n    getField(product, 'Minimum Stock'),\n    'Minimum Stock',\n    productId\n  );\n\n  // Our practice target is twice the minimum stock\n  const targetStock = minimumStock * 2;\n\n  const reorderQuantity = Math.max(\n    0,\n    Math.ceil(targetStock - currentStock)\n  );\n\n  // Determine restocking priority\n  let priority = 'NORMAL';\n\n  if (currentStock === 0) {\n    priority = 'CRITICAL';\n\n  } else if (currentStock <= minimumStock / 2) {\n    priority = 'HIGH';\n\n  } else if (currentStock <= minimumStock) {\n    priority = 'MEDIUM';\n  }\n\n  const needsRestocking = currentStock <= minimumStock;\n\n  return {\n    json: {\n      productId,\n      productName,\n      branch,\n      currentStock,\n      minimumStock,\n      targetStock,\n      reorderQuantity,\n      priority,\n      needsRestocking\n    }\n  };\n\n});\n"
      },
