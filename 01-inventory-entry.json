      "name": "03 - Check Current Stock Level"
    },
    {
      "parameters": {
        "jsCode": "\nconst form = $('01 - Inventory Entry Form').first().json;\nconst stock = $input.first().json;\n\n// Find a field regardless of spaces or capitalization\nfunction getField(data, fieldName) {\n  const normalize = (value) =>\n    value.toLowerCase().replace(/\\s+/g, '');\n\n  const key = Object.keys(data).find(\n    k => normalize(k) === normalize(fieldName)\n  );\n\n  return key === undefined ? undefined : data[key];\n}\n\n// Convert a stock value safely into a number\nfunction parseStockNumber(value, fieldName) {\n  if (value === undefined || value === null ||\n      String(value).trim() === '') {\n    throw new Error(fieldName + ' is missing.');\n  }\n\n  const result = Number(\n    String(value).replace(/,/g, '').trim()\n  );\n\n  if (!Number.isFinite(result) || result < 0) {\n    throw new Error(fieldName + ' must be a valid non-negative number.');\n  }\n\n  return result;\n}\n\n// Read submitted form values\nconst quantity = Number(getField(form, 'Quantity'));\n\nconst transactionType = String(\n  getField(form, 'Transaction type') ?? ''\n).trim().toLowerCase();\n\n// Read existing Google Sheets stock values\nconst currentStock = parseStockNumber(\n  getField(stock, 'Current Stock'),\n  'Current Stock'\n);\n\nconst minimumStock = parseStockNumber(\n  getField(stock, 'Minimum Stock'),\n  'Minimum Stock'\n);\n\n// Begin transaction validation\nlet valid = true;\nlet message = '';\nlet newStock = currentStock;\n\nif (!Number.isInteger(quantity) || quantity <= 0) {\n  valid = false;\n  message = 'Quantity must be a positive whole number.';\n\n} else if (transactionType === 'stock in') {\n\n  newStock = currentStock + quantity;\n  message = 'Stock received successfully.';\n\n} else if (transactionType === 'stock out') {\n\n  if (quantity > currentStock) {\n    valid = false;\n    message = 'Insufficient stock available.';\n  } else {\n    newStock = currentStock - quantity;\n    message = 'Stock issued successfully.';\n  }\n\n} else {\n  valid = false;\n  message = 'Unknown transaction type: ' + transactionType;\n}\n\n// Determine inventory status\nconst stockStatus = newStock <= minimumStock\n  ? 'LOW STOCK'\n  : 'AVAILABLE';\n\n// Return data to the next n8n node\nreturn [{\n  json: {\n    ...form,\n    row_number: stock.row_number,\n    transactionType,\n    valid,\n    message,\n    previousStock: currentStock,\n    newStock,\n    minimumStock,\n    stockStatus\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
